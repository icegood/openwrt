
. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

# defined by mtk_soc_eth:
ETH_NAME=eth0

board_config_update
board=$(board_name)
ucidef_add_switch "switch0" "0:lan" "1:lan" "2:lan" "3:wan" "4:wan" "6@${ETH_NAME}"

lan_mac=$(macaddr_setbit_la "$(cat /sys/class/net/${ETH_NAME}/address)")
wan_mac=$(macaddr_add "$lan_mac" 10)

[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
board_config_flush

exit 0
