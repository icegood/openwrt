#include <dt-bindings/leds/common.h>

#include "mt7628an_tplink_8m.dtsi"

/ {
	compatible = "tplink,tl-wa801nd-v5", "mediatek,mt7628an-soc";
	model = "TP-Link TL-WA801ND v5";

	chosen {
		bootargs = "console=ttyS0,115200 loglevel=8";
	};

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 46 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 36 GPIO_ACTIVE_LOW>;
		};

		lan {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 37 GPIO_ACTIVE_LOW>;
		};

		wlan {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		wps_red {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio 43 GPIO_ACTIVE_HIGH>;
		};

		wps_green {
			function = LED_FUNCTION_WPS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 42 GPIO_ACTIVE_HIGH>;
		};
	};
};

&ehci {
	status = "disabled";
};

&ohci {
	status = "disabled";
};

&state_default {
	gpio {
		groups = "p0led_an", "p1led_an", "perst", "refclk",
				"uart1", "wdt", "wled_an";
		function = "gpio";
	};

	lna {
		groups = "uart1";
		function = "sw_r";
	};

	pa {
		groups = "i2s";
		function = "antenna";
	};
};

&spi0 {
	flash@0 {
		partitions {
			/delete-node/ partition@7c0000; // This removes the "config" node 
            /delete-node/ partition@7d0000; // This removes the "factory" node
			partition@0 {
				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* MAC address at 0x1ebf0 inside the boot partition: relocated manually */
					macaddr_boot_part: macaddr@0x1ebf0 {
						reg = <0x1ebf0 0x6>;
					};

					/* EEPROM/calibration at 0x1EC00 inside the boot partition: relocated manually */
					eeprom_boot_part: eeprom@1ec00 {
						reg = <0x1ec00 0x400>;
					};
				};
			};
			/* Override the firmware partition */
			partition@20000 {
				label = "firmware";
				reg = <0x20000 0x7e0000>;
			};
		};
	};
};

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_boot_part>, <&macaddr_boot_part 0>;
	nvmem-cell-names = "eeprom", "mac-address";
};

&ethernet {
	nvmem-cells = <&macaddr_boot_part 1>;
	nvmem-cell-names = "mac-address";
};
