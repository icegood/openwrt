. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

board_config_update

# seems it is useless as iga driver creates them anyway:
# see also https://forum.openwrt.org/t/purpose-and-logic-of-etc-board-json-or-tmp-board-json/244711
#ucidef_set_network_device_path "eth0" "pci0000:00/0000:00:01.3/0000:01:00.0"
#ucidef_set_network_device_path "eth1" "pci0000:00/0000:00:02.1/0000:02:00.0"
#ucidef_set_network_device_path "eth2" "pci0000:00/0000:00:02.2/0000:03:00.0"
