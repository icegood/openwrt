{
  "name": "CI build container",
  "image": "ghcr.io/openwrt/buildbot/buildworker-v3.8.0:v9",
  "features": {
  },
  "runArgs": [
	"--name",
	"openwrt_dev_cicd",
	"--volume",
	"/home/ice/external/openwrt_build/under_env/cicd_home:/builder",
	"--volume",
	"/home/ice/external/openwrt_build/under_env/feeds:/workspaces/feeds",
	"--volume",
	"/home/ice/external/openwrt_build/under_env/mips_origin_check_openwrt:/workspaces/mips_origin_check_openwrt",
  "--oom-score-adj=1000"
],
  "remoteUser": "buildbot",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "plorefice.devicetree"]
    },
    "devcontainer": {
      "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgmp-dev libmpfr-dev libmpc-dev"
    }
  },
  "shutdownAction": "none"
}
